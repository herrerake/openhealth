{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types",
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
