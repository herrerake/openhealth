{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhealth",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Astro site (npm run build:web). The API, agents and demo providers run the Worker first.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/agents/*", "/mock/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openhealth",
      "database_id": "c7607262-f55c-422b-83ba-c5cba2a77fc5",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "openhealth-raw" }],
  "durable_objects": {
    "bindings": [{ "name": "AthleteAgent", "class_name": "AthleteAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AthleteAgent"] }],
  "vars": {
    "SITE_TZ": "America/Chicago",
    "PROVIDER_MODE": "demo",
    "DEMO_EMAIL": "henry@example.com"
  },
  // Worker Previews (one per pull request). Durable Objects are isolated per Preview automatically;
  // D1 and R2 point at shared preview resources so previews never touch production data.
  "previews": {
    "vars": {
      "SITE_TZ": "America/Chicago",
      "PROVIDER_MODE": "demo",
      "DEMO_EMAIL": "henry@example.com"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "openhealth-preview",
        "database_id": "e243db90-a34b-4d79-b08c-3931bde0893d"
      }
    ],
    "r2_buckets": [{ "binding": "RAW", "bucket_name": "openhealth-raw-preview" }],
    // Each Preview gets its own AthleteAgent namespace; the binding is declared so env.AthleteAgent exists.
    "durable_objects": {
      "bindings": [{ "name": "AthleteAgent", "class_name": "AthleteAgent" }]
    }
  }
}
