{
  "name": "openhealth",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "test:worker": "vitest run --project worker",
    "dev": "npm run build:web && wrangler dev",
    "fixtures": "node fixtures/generate.mjs && node fixtures/validate.mjs && tsx scripts/apple-records.ts",
    "seed:mock": "sh scripts/seed-mock.sh",
    "demo:sync": "tsx scripts/demo-sync.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit && tsc -p e2e --noEmit",
    "build:web": "astro build --root web",
    "dev:web": "astro dev --root web",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261027.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@tailwindcss/vite": "4.3.3",
    "agents": "0.31.0",
    "astro": "7.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "lucide-react": "1.62.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  }
}
