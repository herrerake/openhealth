---
import "../styles/globals.css";

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · OpenHealth</title>
  </head>
  <body class="min-h-dvh">
    <main class:list={["mx-auto w-full px-4 py-8 sm:px-6", wide ? "max-w-6xl" : "max-w-xl"]}>
      <slot />
    </main>
  </body>
</html>
