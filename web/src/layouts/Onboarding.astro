---
import App from "./App.astro";

interface Props {
  title: string;
  step: 1 | 2 | 3;
  heading: string;
  lede?: string;
}
const { title, step, heading, lede } = Astro.props;
const STEPS = ["Profile", "Connect", "Sync"];
---

<App title={title} narrow signedIn={step > 1}>
  <p slot="header" class="text-muted-foreground hidden text-xs font-medium tabular-nums sm:block">Step {step} of {STEPS.length}</p>
  <nav aria-label="Onboarding progress" class="animate-rise">
    <ol class="grid grid-cols-3 gap-1.5">
      {
        STEPS.map((label, i) => (
          <li aria-current={i + 1 === step ? "step" : undefined} class="grid gap-2">
            <span class:list={["h-1 rounded-full transition-colors", i + 1 <= step ? "bg-brand" : "bg-muted"]} />
            <span class:list={["text-[11px] font-medium tracking-wide uppercase", i + 1 === step ? "text-foreground" : "text-muted-foreground"]}>
              {label}
            </span>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="animate-rise mt-10 [animation-delay:60ms]">
    <h1 class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.025em] text-balance sm:text-[2.25rem]">{heading}</h1>
    {lede && <p class="text-muted-foreground mt-3 text-[15px] leading-relaxed text-pretty">{lede}</p>}
  </div>
  <div class="animate-rise mt-8 [animation-delay:120ms]">
    <slot />
  </div>
</App>
